@model IEnumerable<GymAkhada.Models.GymSubcategory>

@{
    ViewData["Title"] = "AKHADA Subcategories";
}

<div class="container mt-4">
    <section class="master-hero">
        <div>
            <span class="master-eyebrow">Master Setup</span>
            <h1>AKHADA Subcategory Master</h1>
            <p>Maintain age and weight criteria under each AKHADA category.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-warning fw-semibold">Add New Subcategory</a>
        }
    </section>

    <section class="master-panel">
        <div class="master-panel-header">
            <div>
                <h2>Saved Subcategories</h2>
                <p>@Model.Count() record(s) available</p>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="master-empty">
                <h3>No subcategories added yet</h3>
                <p>Create age and weight criteria after adding at least one category.</p>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Create" class="btn btn-outline-warning">Create First Subcategory</a>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Subcategory</th>
                            <th>Entry Fee</th>
                            <th>Details</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                @foreach (var item in Model) {
                        <tr>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    @Html.DisplayFor(modelItem => item.GymCategory!.Gym_categoryName)
                                </span>
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(item.SubcategoryName) 
                                    ? (item.GymSub_age > 0 ? $"Age {item.GymSub_age}" : "") + (item.GymWeight > 0 ? $" - {item.GymWeight:0.##}kg" : "No Name") 
                                    : item.SubcategoryName)
                            </td>
                            <td>@(item.EntryFee.HasValue ? $"₹{item.EntryFee.Value:0.00}" : "Free")</td>
                            <td>@(string.IsNullOrEmpty(item.ImportantDetails) ? "-" : item.ImportantDetails)</td>
                            <td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.GymSub_ID" class="btn btn-sm btn-outline-light me-1">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.GymSub_ID" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this subcategory?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-controller="MemberPortal" asp-action="Index" class="btn btn-sm btn-warning fw-bold">
                                        <i class="bi bi-trophy-fill"></i> Join
                                    </a>
                                }
                            </td>
                        </tr>
                }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
