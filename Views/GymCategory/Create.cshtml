@model GymAkhada.Models.GymCategory

@{
    ViewData["Title"] = "Create Category";
}

<div class="container mt-4 text-light">
    <section class="master-hero compact">
        <div>
            <span class="master-eyebrow">Category Master</span>
            <h1>Add AKHADA category</h1>
            <p>Create a master category range that can be linked with subcategory rules later.</p>
        </div>
    </section>

    <div class="row g-4">
        <div class="col-lg-7">
            <form asp-action="Create" class="master-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group mb-3">
                    <label asp-for="Gym_categoryName" class="form-label"></label>
                    <input asp-for="Gym_categoryName" class="form-control form-control-lg" placeholder="e.g. 15-21" />
                    <div class="form-hint">Use a clear range or category name so it is easy to select later.</div>
                    <span asp-validation-for="Gym_categoryName" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Gym_Remarks" class="form-label"></label>
                    <input asp-for="Gym_Remarks" class="form-control form-control-lg" placeholder="Short notes for this category" />
                    <span asp-validation-for="Gym_Remarks" class="text-danger"></span>
                </div>
                <div class="form-actions">
                    <input type="submit" value="Save Category" class="btn btn-warning fw-semibold" />
                    <a asp-action="Index" class="btn btn-outline-light">Back to List</a>
                </div>
            </form>
        </div>
        <div class="col-lg-5">
            <aside class="master-help">
                <h2>What this saves</h2>
                <p>This form stores category master data in the GymCategories table.</p>
                <ul>
                    <li>Category name is required.</li>
                    <li>Remarks help identify the purpose of the category.</li>
                    <li>Subcategory age and weight rules are modelled separately.</li>
                </ul>
            </aside>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
