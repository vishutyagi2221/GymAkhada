@model GymAkhada.Models.GymMember

@{
    ViewData["Title"] = "My Member Portal";
}

<div class="container mt-4">
    <section class="master-hero">
        <div>
            <span class="master-eyebrow">Welcome Back</span>
            <h1>Hi, @Model.FullName</h1>
            <p>Here you can view your personal gym details, schedule, and payments.</p>
        </div>
    </section>

    <div class="row mt-4">
        <!-- Personal Details -->
        <div class="col-md-6 mb-4">
            <div class="master-panel h-100">
                <h3 class="text-warning mb-3">My Profile</h3>
                <table class="table table-dark table-borderless">
                    <tbody>
                        <tr>
                            <td class="text-secondary w-50">Member Type</td>
                            <td class="fw-bold">@Model.MemberType</td>
                        </tr>
                        <tr>
                            <td class="text-secondary">Category</td>
                            <td><span class="category-pill">@(Model.GymCategory?.Gym_categoryName ?? "Not Assigned")</span></td>
                        </tr>
                        <tr>
                            <td class="text-secondary">Joining Date</td>
                            <td>@Model.JoiningDate.ToString("dd MMM yyyy")</td>
                        </tr>
                        <tr>
                            <td class="text-secondary">Current Weight</td>
                            <td>@Model.WeightKg kg</td>
                        </tr>
                        <tr>
                            <td class="text-secondary">Today's Attendance</td>
                            <td>
                                @if (ViewBag.TodaysAttendance != null)
                                {
                                    var attendance = (GymAkhada.Models.Attendance)ViewBag.TodaysAttendance;
                                    if (attendance.IsPresent && attendance.IsApproved)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Marked Present</span>
                                    }
                                    else if (attendance.IsPresent && !attendance.IsApproved)
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Pending Admin Approval</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Absent</span>
                                    }
                                }
                                else
                                {
                                    <form asp-action="MarkAttendance" method="post">
                                        <button type="submit" class="btn btn-warning btn-sm fw-bold">MARK MY ATTENDANCE</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tournaments -->
        <div class="col-md-6 mb-4">
            <div class="master-panel h-100 border-warning" style="border: 1px solid">
                <h3 class="text-warning mb-3">🏅 Upcoming Tournaments</h3>
                
                @if (ViewBag.Tournaments != null)
                {
                    var tournaments = (IEnumerable<GymAkhada.Models.Tournament>)ViewBag.Tournaments;
                    if (!tournaments.Any())
                    {
                        <p class="text-secondary small">No upcoming tournaments.</p>
                    }
                    foreach (var t in tournaments)
                    {
                        <div class="alert alert-dark text-light border-secondary mb-3">
                            <h5 class="fw-bold mb-1">@t.Title</h5>
                            <div class="small text-warning mb-2"><i class="bi bi-calendar-event me-1"></i> @t.Date.ToString("MMM dd, yyyy - hh:mm tt")</div>
                            <p class="small text-secondary mb-2">@t.Description</p>
                            
                            <p class="fw-bold small mb-1"><i class="bi bi-geo-alt me-1"></i> Location: @t.Location</p>
                            
                            @if (t.GoldPrize.HasValue || t.SilverPrize.HasValue || t.BronzePrize.HasValue)
                            {
                                <div class="mt-3 p-2 border border-secondary rounded bg-black">
                                    <h6 class="text-white mb-2 fw-bold text-center border-bottom border-secondary pb-1">Prize Distribution</h6>
                                    <div class="d-flex justify-content-around text-center small">
                                        @if (t.GoldPrize.HasValue)
                                        {
                                            <div>
                                                <div class="fs-4">🥇</div>
                                                <div class="text-warning fw-bold">₹@t.GoldPrize.Value.ToString("0")</div>
                                            </div>
                                        }
                                        @if (t.SilverPrize.HasValue)
                                        {
                                            <div>
                                                <div class="fs-4">🥈</div>
                                                <div class="text-secondary fw-bold">₹@t.SilverPrize.Value.ToString("0")</div>
                                            </div>
                                        }
                                        @if (t.BronzePrize.HasValue)
                                        {
                                            <div>
                                                <div class="fs-4">🥉</div>
                                                <div style="color: #cd7f32;" class="fw-bold">₹@t.BronzePrize.Value.ToString("0")</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Google Maps Embed -->
                            <div class="mt-3 mb-3 rounded overflow-hidden">
                                <iframe width="100%" height="150" style="border:0;" loading="lazy" allowfullscreen 
                                    src="https://www.google.com/maps?q=@Uri.EscapeDataString(t.Location)&output=embed">
                                </iframe>
                            </div>
                            <div class="text-end">
                                <a asp-action="TournamentRegistration" asp-route-id="@t.Id" class="btn btn-warning btn-sm fw-bold">
                                    <i class="bi bi-trophy-fill"></i> View & Register
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- My Approved Tournaments -->
    <div class="row mt-4">
        <div class="col-12 mb-4">
            <div class="master-panel h-100 border-success" style="border: 1px solid">
                <h3 class="text-success mb-3">✅ My Tournaments (Approved)</h3>
                
                @if (ViewBag.MyRegistrations != null)
                {
                    var myRegistrations = (IEnumerable<GymAkhada.Models.TournamentRegistration>)ViewBag.MyRegistrations;
                    if (!myRegistrations.Any())
                    {
                        <p class="text-secondary small">You haven't been approved for any tournaments yet.</p>
                    }
                    else
                    {
                        <div class="row">
                        @foreach (var reg in myRegistrations)
                        {
                            var t = reg.Tournament;
                            var sub = reg.GymSubcategory;
                            var catName = sub?.GymCategory?.Gym_categoryName ?? "Unknown";
                            var subName = !string.IsNullOrEmpty(sub?.SubcategoryName) ? sub.SubcategoryName : "General";

                            <div class="col-md-6 col-lg-4 mb-3">
                                <div class="alert alert-dark text-light border-success h-100 mb-0">
                                    <span class="badge bg-success mb-2">@catName - @subName</span>
                                    <h5 class="fw-bold mb-1">@t!.Title</h5>
                                    <div class="small text-warning mb-2"><i class="bi bi-calendar-event me-1"></i> @t.Date.ToString("MMM dd, yyyy - hh:mm tt")</div>
                                    <p class="fw-bold small mb-1"><i class="bi bi-geo-alt me-1"></i> Location: @t.Location</p>
                                </div>
                            </div>
                        }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
