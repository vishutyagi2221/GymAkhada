@model GymAkhada.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "_Layout";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card bg-dark text-light shadow-lg p-4 border border-secondary" style="width: 100%; max-width: 500px; border-radius: 15px;">
        <div class="text-center mb-4">
            <h2 class="fw-bold" style="color: #ff416c;">Join AKHADA</h2>
            <p class="text-secondary">Create a new member account</p>
        </div>

        <form asp-action="Register" method="post" id="registerForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-floating mb-3">
                <input asp-for="FullName" class="form-control bg-dark text-white border-secondary" placeholder="Full Name" />
                <label asp-for="FullName" class="text-secondary">Full Name</label>
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ContactNumber" class="form-control bg-dark text-white border-secondary" placeholder="Contact Number" />
                <label asp-for="ContactNumber" class="text-secondary">Contact Number</label>
                <span asp-validation-for="ContactNumber" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Email" type="email" class="form-control bg-dark text-white border-secondary" placeholder="Email Address" />
                <label asp-for="Email" class="text-secondary">Email Address</label>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Age" type="number" class="form-control bg-dark text-white border-secondary" placeholder="Age" />
                <label asp-for="Age" class="text-secondary">Age</label>
                <span asp-validation-for="Age" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control bg-dark text-white border-secondary" placeholder="Username" />
                <label asp-for="Username" class="text-secondary">Username</label>
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password" type="password" class="form-control bg-dark text-white border-secondary" placeholder="Password" />
                <label asp-for="Password" class="text-secondary">Password</label>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="ConfirmPassword" type="password" class="form-control bg-dark text-white border-secondary" placeholder="Confirm Password" />
                <label asp-for="ConfirmPassword" class="text-secondary">Confirm Password</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <button type="button" onclick="confirmRegistration()" class="btn btn-lg text-white fw-bold" style="background: linear-gradient(to right, #ff416c, #ff4b2b); border: none; border-radius: 50px;">
                    Register Now
                </button>
            </div>
            
            <div class="text-center mt-3">
                <p class="text-muted small">Already have an account? <a asp-controller="Account" asp-action="Login" class="text-decoration-none" style="color: #ff416c;">Login here</a></p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmRegistration() {
            var form = $('#registerForm');
            
            // Validate form before showing popup
            if (!form.valid()) {
                return;
            }

            var fullName = document.getElementById('FullName').value;
            var contact = document.getElementById('ContactNumber').value;
            var email = document.getElementById('Email').value;
            var age = document.getElementById('Age').value;
            var username = document.getElementById('Username').value;

            Swal.fire({
                title: 'Review Registration Details',
                html: `
                    <div style="text-align: left; padding: 10px; border-radius: 10px; background-color: #2c3034; margin-top: 10px; font-size: 1.05em;">
                        <p style="margin: 8px 0;"><strong>Name:</strong> <span style="color: #ff416c;">${fullName}</span></p>
                        <p style="margin: 8px 0;"><strong>Phone:</strong> <span style="color: #ff416c;">${contact}</span></p>
                        <p style="margin: 8px 0;"><strong>Email:</strong> <span style="color: #ff416c;">${email}</span></p>
                        <p style="margin: 8px 0;"><strong>Age:</strong> <span style="color: #ff416c;">${age}</span></p>
                        <p style="margin: 8px 0;"><strong>Username:</strong> <span style="color: #ff416c;">${username}</span></p>
                    </div>
                    <p style="margin-top: 15px; font-size: 0.9em; color: #aaa;">Are you sure you want to create an account with these details?</p>
                `,
                imageUrl: '/images/logo.png',
                imageWidth: 80,
                imageAlt: 'Akhada Logo',
                background: '#212529',
                color: '#fff',
                showCancelButton: true,
                confirmButtonColor: '#ff416c',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Register Me! 💪',
                cancelButtonText: 'Edit Details ✏️'
            }).then((result) => {
                if (result.isConfirmed) {
                    form[0].submit();
                }
            });
        }
    </script>
}
