@model IEnumerable<GymAkhada.Models.Tournament>

@{
    ViewData["Title"] = "Manage Tournaments";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🏆 Manage Tournaments</h2>
        <a asp-action="Create" class="btn btn-warning fw-bold text-dark">
            <i class="bi bi-plus-circle"></i> Add New Tournament
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-warning">@item.Title</td>
                        <td>@item.Date.ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td>@item.Location</td>
                        <td>
                            <a asp-action="Registrations" asp-route-id="@item.Id" class="btn btn-sm btn-info text-dark me-2">Registrations</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-light me-2">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this tournament?');">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if(!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">No tournaments added yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
