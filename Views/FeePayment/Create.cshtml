@model GymAkhada.Models.FeePayment

@{
    ViewData["Title"] = "Add Payment - AKHADA";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <section class="master-hero">
                <div>
                    <span class="master-eyebrow">Transaction</span>
                    <h1>Add New Payment</h1>
                    <p>Record a new fee receipt for an existing gym member.</p>
                </div>
            </section>

            <section class="master-panel p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label asp-for="GymMember_ID" class="form-label text-warning"></label>
                            <select asp-for="GymMember_ID" class="form-select bg-dark text-light border-secondary" asp-items="ViewBag.GymMember_ID">
                                <option value="">-- Select Member --</option>
                            </select>
                            <span asp-validation-for="GymMember_ID" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Amount" class="form-label text-warning"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark text-secondary border-secondary">₹</span>
                                <input asp-for="Amount" class="form-control bg-dark text-light border-secondary" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PaymentMode" class="form-label text-warning"></label>
                            <select asp-for="PaymentMode" class="form-select bg-dark text-light border-secondary">
                                <option value="Cash">Cash</option>
                                <option value="UPI">UPI</option>
                                <option value="Card">Card</option>
                                <option value="Bank Transfer">Bank Transfer</option>
                            </select>
                            <span asp-validation-for="PaymentMode" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="PaymentDate" class="form-label text-warning"></label>
                            <input asp-for="PaymentDate" class="form-control bg-dark text-light border-secondary" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="PaymentDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ValidTill" class="form-label text-warning"></label>
                            <input asp-for="ValidTill" class="form-control bg-dark text-light border-secondary" type="date" value="@DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="ValidTill" class="text-danger"></span>
                        </div>

                        <div class="col-md-12 mb-4">
                            <label asp-for="Remarks" class="form-label text-warning"></label>
                            <textarea asp-for="Remarks" class="form-control bg-dark text-light border-secondary" rows="2" placeholder="Any optional note..."></textarea>
                            <span asp-validation-for="Remarks" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                        <button type="submit" class="btn btn-warning fw-bold px-5">SAVE PAYMENT</button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
