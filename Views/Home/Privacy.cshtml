@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="container mt-4">
    <h1 class="text-warning border-bottom border-secondary pb-2 mb-4">@ViewData["Title"]</h1>

    <div class="card bg-dark border-secondary text-light p-4 shadow-sm rounded-4">
        <h4 class="text-info mb-3">Welcome to AKHADA</h4>
        <p>Your privacy is important to us. This Privacy Policy explains how we collect, use, and protect the personal information of our members.</p>
        
        <h5 class="text-warning mt-4">1. Information We Collect</h5>
        <p>We collect information such as your name, contact details, physical address, age, gender, and membership preferences when you register at AKHADA.</p>
        
        <h5 class="text-warning mt-4">2. How We Use Your Information</h5>
        <ul>
            <li>To manage your membership and subscriptions.</li>
            <li>To communicate with you regarding your fitness plans, renewals, and special offers.</li>
            <li>To ensure safety and personalized fitness tracking.</li>
        </ul>

        <h5 class="text-warning mt-4">3. Data Protection</h5>
        <p>We implement strict security measures to protect your personal data from unauthorized access. Your data is stored securely in our local database and is not shared with third-party marketers.</p>

        <h5 class="text-warning mt-4">4. Contact Us</h5>
        <p>If you have any questions regarding this Privacy Policy, please contact the AKHADA management desk.</p>
    </div>
</div>
