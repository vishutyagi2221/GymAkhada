@model IEnumerable<GymAkhada.Models.Tournament>
@{
    ViewData["Title"] = "Home - AKHADA Management System";
}

<div class="container mt-5">
    <!-- Hero Section -->
    <div class="row align-items-center mb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <span class="text-warning text-uppercase fw-bold tracking-wide mb-2 d-block">Premium Software</span>
            <h1 class="display-3 fw-bold text-light mb-4" style="line-height: 1.1;">
                Elevate Your <span class="text-warning">Akhada</span> Experience.
            </h1>
            <p class="lead text-secondary mb-4">
                The ultimate management system to track members, organize bouts, manage daily attendance, and keep your finances in check—all in one place.
            </p>
            @if (!User.Identity!.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-warning btn-lg fw-bold px-5 py-3 rounded-0 text-dark me-3">LOGIN TO PORTAL</a>
            }
            else
            {
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="AdminDashboard" asp-action="Index" class="btn btn-warning btn-lg fw-bold px-5 py-3 rounded-0 text-dark">GO TO DASHBOARD</a>
                }
            }
        </div>
        <div class="col-lg-6 text-center">
            <!-- Decorative Graphic/Icon -->
            <div class="master-panel border-warning p-4 text-center d-inline-block rounded-circle bg-black" style="width: 300px; height: 300px; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 40px rgba(255, 193, 7, 0.1);">
                <img src="~/images/logo.png" alt="AKHADA Logo" class="img-fluid rounded-circle" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="row text-center mt-5 pt-5 border-top border-secondary">
        <div class="col-md-4 mb-4">
            <div class="master-panel h-100 p-4 hover-lift">
                <i class="bi bi-people-fill text-warning mb-3" style="font-size: 3rem;"></i>
                <h4 class="text-light fw-bold">Member Tracking</h4>
                <p class="text-secondary">Keep detailed records of every pehlwan, their weight categories, and joining dates.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="master-panel h-100 p-4 hover-lift">
                <i class="bi bi-wallet2 text-success mb-3" style="font-size: 3rem;"></i>
                <h4 class="text-light fw-bold">Fee Management</h4>
                <p class="text-secondary">Never miss a payment. Track dues, receipts, and get automatic expiry alerts.</p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="master-panel h-100 p-4 hover-lift">
                <i class="bi bi-calendar2-check-fill text-info mb-3" style="font-size: 3rem;"></i>
                <h4 class="text-light fw-bold">Daily Attendance</h4>
                <p class="text-secondary">Mark presence and monitor daily discipline with a dedicated attendance module.</p>
            </div>
        </div>
    </div>
    <!-- Tournaments Section -->
    @if (Model != null && Model.Any())
    {
        <div class="row mt-5 pt-5 border-top border-secondary">
            <div class="col-12 text-center mb-4">
                <h2 class="text-warning fw-bold">🏅 Upcoming Akhada Tournaments</h2>
                <p class="text-secondary">Join us at the biggest wrestling events across the region.</p>
            </div>
            
            @foreach (var t in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="master-panel border-warning h-100 p-4">
                        <h4 class="text-light fw-bold mb-2">@t.Title</h4>
                        <div class="text-warning mb-2"><i class="bi bi-calendar-event me-2"></i>@t.Date.ToString("MMMM dd, yyyy - hh:mm tt")</div>
                        <p class="text-secondary mb-3">@t.Description</p>
                        <p class="text-light fw-bold small"><i class="bi bi-geo-alt me-2"></i>Location: @t.Location</p>
                        
                        <div class="mt-3 rounded overflow-hidden shadow">
                            <iframe width="100%" height="250" style="border:0;" allowfullscreen="" loading="lazy" 
                                    src="https://maps.google.com/maps?q=@Uri.EscapeDataString(t.Location)&t=&z=13&ie=UTF8&iwloc=&output=embed">
                            </iframe>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .hover-lift {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hover-lift:hover {
        transform: translateY(-10px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        border-color: #ffc107;
    }
    .tracking-wide {
        letter-spacing: 2px;
    }
</style>
